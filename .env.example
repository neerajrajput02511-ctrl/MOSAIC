# ==========================================
# WEATHERFUSION AI - ENVIRONMENT VARIABLES
# SIH26081: Hybrid AI–NWP Forecast Blending
# ==========================================

# ==========================================
# DATABASE
# ==========================================
DATABASE_URL=sqlite:///./weatherfusion.db
# For PostgreSQL with PostGIS:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/weatherfusion

# ==========================================
# CACHING & QUEUES (OPTIONAL)
# ==========================================
REDIS_URL=redis://localhost:6379/0

# ==========================================
# APPLICATION & SECURITY
# ==========================================
SECRET_KEY=change-this-in-production-use-strong-secret-key-32chars
APP_ENV=development
LOG_LEVEL=INFO
DEMO_MODE=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# OFFICIAL INDIA METEOROLOGICAL DEPARTMENT (IMD)
# Registration: https://api.imd.gov.in / National Data Center
# If unconfigured, system falls back to IMD public regional RSS/AWS bulletin feeds
# ==========================================
IMD_API_BASE_URL=https://api.imd.gov.in
IMD_API_KEY=

# ==========================================
# ISRO MOSDAC (Space Applications Centre)
# Registration: https://mosdac.gov.in
# Used for GSMaP_ISRO satellite precipitation and INSAT-3DR/3D sounder validation
# ==========================================
MOSDAC_API_BASE_URL=https://mosdac.gov.in/api/v1
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# ==========================================
# ECMWF (European Centre for Medium-Range Weather Forecasts)
# Registration: https://www.ecmwf.int
# Used for direct MARS / ECPDS access if bypassing public high-res mirrors
# ==========================================
ECMWF_API_KEY=
ECMWF_API_EMAIL=

# ==========================================
# MAP PROVIDERS & GEOCODING
# MapTiler: https://cloud.maptiler.com
# Mapbox: https://account.mapbox.com
# ==========================================
MAPTILER_API_KEY=
MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_MAPTILER_API_KEY=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ==========================================
# AI / LLM COPILOT (OPTIONAL)
# Used for grounded meteorological natural-language synthesis
# ==========================================
GEMINI_API_KEY=
OPENAI_API_KEY=
